{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mailpit Community Docs",
  "description": "Unofficial, task-based documentation for Mailpit, the open-source email testing tool: catch email from your app on localhost, inspect it, and test it in CI. Written for Mailpit v1.33.",
